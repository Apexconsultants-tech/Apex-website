# Security headers, replacing the ones previously set in next.config.ts's
# headers() block — that only worked with a live Next.js server, which
# doesn't exist on this static HostGator deployment.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# next build with output: "export" writes each page as a flat file, e.g.
# study-in-uk.html, not study-in-uk/index.html — but every canonical tag,
# internal <Link>, and sitemap entry on this site points to the extension-
# less URL (/study-in-uk). Without this rewrite, none of those would
# resolve on plain Apache.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # An exact physical file (contact.php, /_next/static/*, /images/*, the
  # root index.html, etc.) is served as-is, unrewritten.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /study-in-uk -> study-in-uk.html, when that file exists. This must
  # come before the directory check below: dynamic routes each also get a
  # same-named folder (e.g. out/study-in-uk/) containing only internal
  # Next.js payload files, not a page — checking -f above first and this
  # rewrite next means that folder never gets a chance to shadow the real
  # page at study-in-uk.html.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # An actual directory with its own content (not one of the payload-only
  # route folders above, which are only ever reached via the .html rule)
  # is left for Apache to handle normally.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Serve the site's own branded 404 page instead of Apache's default for any
# path that matches nothing above.
ErrorDocument 404 /404.html

# Long browser cache for static assets. Images/CSS/JS are the bulk of page
# weight and rarely change in place on this site (updates go out as new
# deploys, not in-place file edits), so a 1-year cache trades a small risk
# of stale content after a same-name file replacement for much faster
# repeat visits. HTML is deliberately excluded so page content updates
# still show up immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
