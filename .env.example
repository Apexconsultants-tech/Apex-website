# No environment variables are currently required to run this project.
#
# The contact form (src/components/ContactForm.tsx) submits directly to
# Netlify Forms — Netlify detects the form at build time from the
# prerendered HTML and handles storage, spam filtering, and email
# notifications itself. Configure the notification email address in the
# Netlify dashboard (Site configuration -> Forms -> Form notifications),
# not through code or env vars.
