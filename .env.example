# SMTP credentials for the contact form (src/lib/mailer.ts, src/app/actions.ts).
# Without these set, enquiries are validated and logged server-side instead
# of emailed — the site still runs, contact form submissions just aren't
# delivered until these are configured.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER if unset.
CONTACT_TO_EMAIL=
