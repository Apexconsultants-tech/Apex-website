# SMTP credentials for the contact form (src/lib/mailer.ts, src/app/actions.ts).
# The mailbox lives on HostGator/cPanel, not this Netlify deployment. Without
# these set, the contact form correctly returns an error to the visitor
# instead of pretending the enquiry was sent.
#
# Find these values in cPanel: Email Accounts -> info@apexconsultants.org ->
# Connect Devices (or "Set Up Mail Client"). Use the values under "Secure SSL/TLS
# Settings", not the older non-SSL ones.

# Usually mail.apexconsultants.org — copy exactly from cPanel, don't guess.
SMTP_HOST=
# 465 (SSL) is the common HostGator default; use 587 (TLS) if cPanel lists that instead.
SMTP_PORT=465
# The full mailbox address, e.g. info@apexconsultants.org
SMTP_USER=
# The mailbox password — set this directly in Netlify's dashboard, never here or in git.
SMTP_PASS=
# Where enquiries are delivered. Defaults to SMTP_USER if unset.
CONTACT_TO_EMAIL=info@apexconsultants.org
