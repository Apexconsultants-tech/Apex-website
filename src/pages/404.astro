---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { contact } from "@/lib/site-config";
---
<BaseLayout title="Page Not Found" description="The page you were looking for may have moved or no longer exists." canonical="/404" noindex>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-5 py-24 text-center lg:px-8">
    <p class="font-display text-6xl font-semibold text-brand">404</p>
    <h1 class="mt-4 text-3xl font-semibold text-ink sm:text-4xl">We couldn't find that page</h1>
    <p class="mt-4 max-w-md text-ink-soft">The page you were looking for may have moved or no longer exists. Try one of these instead:</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-gradient-to-b from-brand to-brand-deep px-6 py-3 text-sm font-semibold text-white shadow-md shadow-brand/20 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand/30">Go to homepage</a>
      <a href="/#destinations" class="rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink transition-all hover:-translate-y-0.5 hover:border-brand hover:text-brand">Study destinations</a>
      <a href="/contact-us" class="rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink transition-all hover:-translate-y-0.5 hover:border-brand hover:text-brand">Contact us</a>
    </div>
    <p class="mt-8 text-sm text-ink-faint">
      Or call us directly at <a href={contact.phoneHref} data-track="phone_click" class="font-semibold text-brand-text underline underline-offset-2 hover:decoration-2">{contact.phoneDisplay}</a>
    </p>
  </section>
</BaseLayout>
