---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CoursesBrowser from "@/components/CoursesBrowser.astro";
import JsonLd from "@/components/JsonLd.astro";
import Reveal from "@/components/Reveal.astro";
import { courses } from "@/lib/courses-data";
import { breadcrumbJsonLd } from "@/lib/structured-data";

const title = "Study Abroad Courses";
const description = "Explore undergraduate, postgraduate, and diploma programs at Apex's partner universities across the UK, USA, and Australia.";
---
<BaseLayout title={title} description={description} canonical="/courses">
  <JsonLd data={breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Courses", path: "/courses" }])} />
  <section class="mx-auto max-w-7xl px-5 pb-12 pt-10 lg:px-8 lg:pt-14">
    <Breadcrumb current="Courses" />
    <div class="mt-6 max-w-3xl animate-hero-in">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">Programs worldwide</p>
      <h1 class="mt-3 text-4xl font-semibold leading-[1.06] text-ink sm:text-5xl">Study Abroad <span class="text-brand">Courses</span></h1>
      <p class="mt-6 text-base leading-relaxed text-ink-soft sm:text-lg">Explore undergraduate, postgraduate, and diploma programs at our partner universities across the UK, USA, and Australia.</p>
    </div>
    <div class="mt-8 grid grid-cols-3 gap-4 sm:max-w-md animate-hero-in" style="animation-delay: 100ms">
      <div class="rounded-xl border border-line bg-surface px-3 py-3 text-center">
        <p class="font-display text-lg font-semibold text-brand-text">{courses.length}+</p>
        <p class="mt-0.5 text-[11px] leading-tight text-ink-faint">Courses listed</p>
      </div>
      <div class="rounded-xl border border-line bg-surface px-3 py-3 text-center">
        <p class="font-display text-lg font-semibold text-brand-text">3</p>
        <p class="mt-0.5 text-[11px] leading-tight text-ink-faint">Destinations</p>
      </div>
      <div class="rounded-xl border border-line bg-surface px-3 py-3 text-center">
        <p class="font-display text-lg font-semibold text-brand-text">13+</p>
        <p class="mt-0.5 text-[11px] leading-tight text-ink-faint">Partner universities</p>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-surface-2/60 py-16">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <Reveal><CoursesBrowser /></Reveal>
    </div>
  </section>
</BaseLayout>
