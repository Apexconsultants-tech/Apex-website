---
import { Image } from "astro:assets";
import { img } from "@/lib/images";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import JsonLd from "@/components/JsonLd.astro";
import Reveal from "@/components/Reveal.astro";
import { blogPosts, getBlogPost } from "@/lib/blog-data";
import { ogUrl } from "@/lib/images";
import { contact } from "@/lib/site-config";
import { articleJsonLd, breadcrumbJsonLd } from "@/lib/structured-data";

export function getStaticPaths() {
  return blogPosts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!)!;
const others = blogPosts.filter((p) => p.slug !== post.slug);
const wordCount =
  post.intro.split(/\s+/).length +
  post.sections.reduce((sum, sec) => sum + sec.body.split(/\s+/).length, 0) +
  (post.closing?.split(/\s+/).length ?? 0);
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
const ogImage = post.image ? await ogUrl(post.image) : undefined;
---
<BaseLayout title={post.title} description={post.excerpt} canonical={`/blogs/${slug}`} ogImage={ogImage} type="article">
  <JsonLd data={[breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Blog", path: "/blogs" }, { name: post.title, path: `/blogs/${slug}` }]), articleJsonLd(post)]} />
  <article class="mx-auto max-w-3xl px-5 pb-16 pt-10 lg:px-8 lg:pt-14">
    <Breadcrumb current={post.title} />
    <div class="mt-6 animate-hero-in">
      <p class="text-xs font-medium text-ink-faint">{post.category} &middot; {post.date} &middot; {readingMinutes} min read</p>
      <h1 class="mt-3 text-3xl font-semibold leading-tight text-ink sm:text-4xl">{post.title}</h1>
      <p class="mt-4 text-sm text-ink-faint">By Apex Consulting Services</p>
    </div>

    {post.image && (
      <div class="mt-8 overflow-hidden rounded-2xl border border-line animate-hero-in" style="animation-delay: 60ms">
        <Image src={img(post.image)} alt={post.imageAlt ?? post.title} width={1000} height={667} loading="eager" fetchpriority="high" class="h-56 w-full object-cover sm:h-80" />
      </div>
    )}

    <Reveal delay={80} class="mt-8"><p class="text-lg leading-relaxed text-ink-soft">{post.intro}</p></Reveal>

    <div class="mt-8 space-y-8">
      {post.sections.map((sec, i) => (
        <Reveal delay={i * 60}>
          {sec.heading && <h2 class="text-xl font-semibold text-ink">{sec.heading}</h2>}
          <p class="mt-2 leading-relaxed text-ink-soft">{sec.body}</p>
        </Reveal>
      ))}
    </div>

    {post.closing && <Reveal delay={140} class="mt-8"><p class="leading-relaxed text-ink-soft">{post.closing}</p></Reveal>}

    {post.relatedLinks && post.relatedLinks.length > 0 && (
      <Reveal delay={170} class="mt-8 border-t border-line pt-6">
        <p class="text-xs font-semibold uppercase tracking-[0.1em] text-ink-faint">Related reading</p>
        <ul class="mt-3 space-y-2">
          {post.relatedLinks.map((l) => (
            <li><a href={l.href} class="text-sm font-semibold text-brand-text hover:underline">{l.label} →</a></li>
          ))}
        </ul>
      </Reveal>
    )}

    <Reveal delay={200} class="mt-12 rounded-2xl border border-line bg-surface-2/60 p-6">
      <h3 class="text-base font-semibold text-ink">Need expert guidance?</h3>
      <p class="mt-1 text-sm text-ink-soft">Our counselors can help with admissions, visas, and course selection.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/contact-us" class="rounded-full bg-gradient-to-b from-brand to-brand-deep px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-brand/20 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand/30">Contact Us</a>
        <a href={contact.whatsappHref} data-track="whatsapp_click" target="_blank" rel="noopener noreferrer" class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-ink transition-all hover:-translate-y-0.5 hover:border-brand hover:text-brand">Chat on WhatsApp</a>
      </div>
    </Reveal>
  </article>

  <section class="border-t border-line bg-surface-2/60 py-16">
    <div class="mx-auto max-w-3xl px-5 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.1em] text-ink-faint">Explore more</p>
      <div class="mt-4 flex flex-wrap gap-4">
        <a href="/blogs" class="text-sm font-semibold text-brand-text hover:underline">All articles</a>
        <a href="/courses" class="text-sm font-semibold text-brand-text hover:underline">Browse courses</a>
        <a href="/#partner-logos" class="text-sm font-semibold text-brand-text hover:underline">Partner universities</a>
      </div>
      {others.length > 0 && (
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {others.map((p) => (
            <a href={`/blogs/${p.slug}`} class="rounded-xl border border-line bg-surface p-4 text-sm font-medium text-ink transition-colors hover:border-brand hover:text-brand">{p.title}</a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
