---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import JsonLd from "@/components/JsonLd.astro";
import Reveal from "@/components/Reveal.astro";
import TestimonialCard from "@/components/TestimonialCard.astro";
import TiltCard from "@/components/TiltCard.astro";
import { testimonials } from "@/lib/site-config";
import { breadcrumbJsonLd } from "@/lib/structured-data";

const title = "Student Success Stories";
const description = "Meet students who secured admissions abroad with guidance from Apex Consulting Services, from applications and documentation to visa support.";
---
<BaseLayout title={title} description={description} canonical="/success-stories">
  <JsonLd data={breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Success Stories", path: "/success-stories" }])} />
  <section class="mx-auto max-w-7xl px-5 pb-12 pt-10 lg:px-8 lg:pt-14">
    <Breadcrumb current="Success Stories" />
    <div class="mt-6 max-w-3xl animate-hero-in">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">Real students. Real results.</p>
      <h1 class="mt-3 text-4xl font-semibold leading-[1.06] text-ink sm:text-5xl">Student <span class="text-brand">Success Stories</span></h1>
      <p class="mt-6 text-base leading-relaxed text-ink-soft sm:text-lg">Meet students who secured admissions abroad with guidance from Apex Consulting Services, from applications and documentation to visa support.</p>
    </div>
    <div class="mt-8 grid grid-cols-3 gap-4 sm:max-w-md animate-hero-in" style="animation-delay: 100ms">
      <div class="rounded-xl border border-line bg-surface px-3 py-3 text-center">
        <p class="font-display text-lg font-semibold text-brand-text">{testimonials.length}+</p>
        <p class="mt-0.5 text-[11px] leading-tight text-ink-faint">Success stories</p>
      </div>
      <div class="rounded-xl border border-line bg-surface px-3 py-3 text-center">
        <p class="font-display text-lg font-semibold text-brand-text">2009</p>
        <p class="mt-0.5 text-[11px] leading-tight text-ink-faint">Trusted guidance since</p>
      </div>
      <div class="rounded-xl border border-line bg-surface px-3 py-3 text-center">
        <p class="font-display text-lg font-semibold text-brand-text">UK &amp; beyond</p>
        <p class="mt-0.5 text-[11px] leading-tight text-ink-faint">Global destinations</p>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-surface-2/60 py-16">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((t, i) => (
          <Reveal delay={(i % 6) * 60}>
            <TiltCard max={4} class="h-full">
              <TestimonialCard item={t} />
            </TiltCard>
          </Reveal>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
