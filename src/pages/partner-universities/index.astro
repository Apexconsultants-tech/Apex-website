---
import { Image } from "astro:assets";
import { img } from "@/lib/images";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import JsonLd from "@/components/JsonLd.astro";
import Reveal from "@/components/Reveal.astro";
import TiltCard from "@/components/TiltCard.astro";
import { partnerUniversities } from "@/lib/universities-data";
import { otherPartnerLogos, type PartnerLogo } from "@/lib/partner-logo-data";
import { flagSize } from "@/lib/flags";
import { contact } from "@/lib/site-config";
import { breadcrumbJsonLd } from "@/lib/structured-data";

const logosByCountry = otherPartnerLogos.reduce<Record<string, PartnerLogo[]>>((acc, u) => {
  (acc[u.country] ??= []).push(u);
  return acc;
}, {});

const title = "Partner Universities Abroad for Pakistani Students";
const description = "Apex Consulting Services works directly with universities across 50+ countries as an authorized representative, not a third-party reseller.";
---
<BaseLayout title={title} description={description} canonical="/partner-universities">
  <JsonLd data={breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Partner Universities", path: "/partner-universities" }])} />
  <section class="mx-auto max-w-7xl px-5 pb-12 pt-10 lg:px-8 lg:pt-14">
    <Breadcrumb current="Partner Universities" />
    <div class="mt-6 max-w-3xl animate-hero-in">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">Global university network</p>
      <h1 class="mt-3 text-4xl font-semibold leading-[1.06] text-ink sm:text-5xl">Partner <span class="text-brand">Universities</span> Worldwide</h1>
      <p class="mt-6 text-base leading-relaxed text-ink-soft sm:text-lg">
        We work directly with universities and institutions across 50+ countries, giving you access
        to a wide range of undergraduate, postgraduate, diploma, language, and professional programs,
        backed by our standing as an authorized representative, not a third-party reseller.
      </p>
    </div>
    <div class="mt-8 grid grid-cols-3 gap-4 sm:max-w-md animate-hero-in" style="animation-delay: 100ms">
      <div class="rounded-xl border border-line bg-surface px-3 py-3 text-center"><p class="font-display text-lg font-semibold text-brand-text">16+</p><p class="mt-0.5 text-[11px] leading-tight text-ink-faint">Partner universities</p></div>
      <div class="rounded-xl border border-line bg-surface px-3 py-3 text-center"><p class="font-display text-lg font-semibold text-brand-text">6+</p><p class="mt-0.5 text-[11px] leading-tight text-ink-faint">Countries</p></div>
      <div class="rounded-xl border border-line bg-surface px-3 py-3 text-center"><p class="font-display text-lg font-semibold text-brand-text">2009</p><p class="mt-0.5 text-[11px] leading-tight text-ink-faint">Trusted guidance since</p></div>
    </div>
  </section>

  <section class="border-t border-line bg-surface-2/60 py-16">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {partnerUniversities.map((u, i) => {
          const fs = flagSize(u.flag, 18);
          return (
            <Reveal delay={(i % 6) * 60}>
              <a href={`/partner-universities/${u.slug}`} class="block h-full">
                <TiltCard class="h-full rounded-2xl border border-line bg-surface p-6 transition-shadow hover:shadow-lg hover:shadow-ink/5" max={5}>
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-base font-semibold leading-snug text-ink">{u.name}</h3>
                    <img src={`/images/flags/${u.flag}.svg`} alt="" width={fs.width} height={fs.height} class="mt-1 shrink-0 rounded-sm" />
                  </div>
                  <p class="mt-2 text-sm text-ink-soft">{u.country} &middot; {u.city}</p>
                  <span class="mt-3 inline-flex text-xs font-semibold text-brand-text">View courses and details →</span>
                </TiltCard>
              </a>
            </Reveal>
          );
        })}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <Reveal class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">Extended network</p>
      <h2 class="mt-2 text-3xl font-semibold leading-tight text-ink sm:text-4xl">More Partner <span class="text-brand">Institutions</span></h2>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">Beyond the universities above, Apex works with institutions across the UK, USA, Australia, Germany, and Ireland.</p>
    </Reveal>
    <div class="mt-10 space-y-10">
      {Object.entries(logosByCountry).map(([country, logos]) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-faint">{country}</h3>
          <div class="mt-4 grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
            {logos.map((u) => (
              <div class="flex h-32 flex-col items-center justify-center gap-3 rounded-xl border border-line bg-surface p-4 text-center shadow-sm shadow-ink/[0.03] transition-shadow hover:shadow-md hover:shadow-ink/[0.06]">
                {u.logo.endsWith(".svg") ? (
                  <img src={`/images/university-logos/${u.logo}`} alt={u.name} width="140" height="56" loading="lazy" class="h-11 w-auto max-w-[130px] object-contain" />
                ) : (
                  <Image src={img(`/images/university-logos/${u.logo}`)} alt={u.name} width={140} height={56} loading="lazy" class="h-11 w-auto max-w-[130px] object-contain" />
                )}
                <p class="text-[11px] font-medium leading-tight text-ink-soft">{u.name}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <Reveal>
      <div class="flex flex-col items-start justify-between gap-8 rounded-3xl bg-brand px-8 py-12 sm:px-12 lg:flex-row lg:items-center">
        <div>
          <h2 class="text-3xl font-semibold text-white sm:text-4xl">Not sure which university fits you?</h2>
          <p class="mt-3 max-w-lg text-white">Tell us your grades, budget, and goals, and we will match you to the right program.</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a href="/contact-us" class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-deep transition-all hover:-translate-y-0.5 hover:bg-white/90">Book free consultation</a>
          <a href={contact.whatsappHref} data-track="whatsapp_click" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/40 px-6 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:border-white">Chat on WhatsApp</a>
        </div>
      </div>
    </Reveal>
  </section>
</BaseLayout>
