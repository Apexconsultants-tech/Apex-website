---
import { Image } from "astro:assets";
import { heroPreload, img } from "@/lib/images";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import JsonLd from "@/components/JsonLd.astro";
import LuggageIllustration from "@/components/LuggageIllustration.astro";
import Reveal from "@/components/Reveal.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import StatStrip from "@/components/StatStrip.astro";
import TiltCard from "@/components/TiltCard.astro";
import { aboutSections, contact, coreValues, journey, offices, site, socials } from "@/lib/site-config";
import { breadcrumbJsonLd } from "@/lib/structured-data";
import { getDestination, popularDestinationSlugs } from "@/lib/destinations-data";

const title = "About Us | Study Abroad Since 2009";
const description =
  "Apex Consulting Services has guided students abroad since 2009, with offices in Karachi (HQ), Hyderabad and the UK. ICEF Agency Status IAS #4511 certified.";

const detailSections = [
  { id: "story", label: "Our Story", ...aboutSections.story },
  { id: "mission", label: "Our Mission", ...aboutSections.mission },
  { id: "vision", label: "Our Vision", ...aboutSections.vision },
  { id: "student-first", label: "Student-First Approach", ...aboutSections.studentFirst },
  { id: "global-focus", label: "Global Education Focus", ...aboutSections.globalFocus },
  { id: "why", label: "Why Choose Apex", ...aboutSections.whyChoose },
] as const;

const hero = await heroPreload("/images/gallery/best-consultancy-for-abroad-studies.webp", {
  widths: [480, 640, 800],
  sizes: "(min-width: 1024px) 45vw, 90vw",
  format: "webp",
  quality: 60,
});
---
<BaseLayout title={title} description={description} canonical="/about-us" heroPreload={hero}>
  <JsonLd data={breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "About Us", path: "/about-us" }])} />

  <section class="mx-auto max-w-7xl px-5 pb-16 pt-14 lg:px-8 lg:pb-20 lg:pt-20">
    <Breadcrumb current="About Us" />
    <div class="mt-6 grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="animate-hero-in">
        <h1 class="text-4xl font-semibold leading-[1.08] text-ink sm:text-5xl">Beyond Numbers, <span class="text-brand">Beyond Borders</span></h1>
        <p class="mt-6 text-base leading-relaxed text-ink-soft sm:text-lg">
          <strong class="text-ink">Apex Consulting Services</strong> is a trusted overseas
          education consultancy, helping students across Pakistan and beyond reach leading
          institutions abroad since <strong class="text-ink">{site.foundedYear}</strong>.
        </p>
        <p class="mt-4 text-base leading-relaxed text-ink-soft">
          With offices in <strong class="text-ink">Karachi</strong> (Head Office),
          <strong class="text-ink">Hyderabad</strong>, and the
          <strong class="text-ink">United Kingdom</strong>, we deliver reliable, transparent,
          and result-oriented guidance, from university and course selection through applications,
          visas, scholarships, and pre-departure support.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact-us" class="rounded-full bg-gradient-to-b from-brand to-brand-deep px-6 py-3 text-sm font-semibold text-white shadow-md shadow-brand/20 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand/30">Book free consultation</a>
          <a href={contact.whatsappHref} data-track="whatsapp_click" target="_blank" rel="noopener noreferrer" class="rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink transition-all hover:-translate-y-0.5 hover:border-brand hover:text-brand">Chat on WhatsApp</a>
        </div>
      </div>
      <TiltCard class="overflow-hidden rounded-3xl border border-line" max={4}>
        <Image src={img("/images/gallery/best-consultancy-for-abroad-studies.webp")} alt="Apex Consulting Services counselors guiding a student" width={800} height={600} loading="eager" fetchpriority="high" decoding="async" widths={[480, 640, 800]} sizes="(min-width: 1024px) 45vw, 90vw" quality={60} class="h-full w-full object-cover" />
      </TiltCard>
    </div>
  </section>

  <section class="border-y border-line bg-surface-2/60 py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <Reveal><SectionHeading align="center" eyebrow="Our principles" title="What we stand for" /></Reveal>
      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {coreValues.map((v, i) => (
          <Reveal delay={i * 80}>
            <TiltCard class="h-full rounded-2xl border border-line bg-surface p-6" max={4}>
              <h3 class="text-base font-semibold text-ink">{v.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{v.body}</p>
            </TiltCard>
          </Reveal>
        ))}
      </div>
      <Reveal delay={200} class="mt-8">
        <TiltCard class="overflow-hidden rounded-3xl border border-line shadow-lg shadow-ink/10" max={3}>
          <Image src={img("/images/stock/students-group.webp")} alt="A diverse group of international students studying together" width={1200} height={675} loading="lazy" class="h-56 w-full object-cover sm:h-72" />
        </TiltCard>
      </Reveal>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pt-20 lg:px-8">
    <Reveal class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
      <TiltCard class="overflow-hidden rounded-3xl border border-line shadow-lg shadow-ink/10" max={4}>
        <Image src={img("/images/stock/advisor-consultation.webp")} alt="Apex counselors reviewing a student's application together" width={1000} height={667} loading="lazy" class="h-64 w-full object-cover sm:h-80" />
      </TiltCard>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">How we work</p>
        <p class="mt-3 text-xl font-semibold leading-snug text-ink sm:text-2xl">Every file gets a counselor who actually reads it, not a queue.</p>
        <p class="mt-4 text-ink-soft leading-relaxed">From your first consultation to the day you land, the same team stays with your application, so you are never re-explaining your situation to someone new.</p>
      </div>
    </Reveal>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div class="flex flex-col gap-14">
      {detailSections.map((sec, i) => {
        const isFeatured = sec.id === "story" || sec.id === "mission" || sec.id === "vision";
        return (
          <Reveal y={isFeatured ? 32 : 16} scale={isFeatured ? 0.95 : 1} delay={isFeatured ? i * 90 : 0}>
            <div id={sec.id} class="grid grid-cols-1 gap-8 lg:grid-cols-[220px_1fr]">
              <h2 class="text-2xl font-semibold text-ink">{sec.label}</h2>
              <div class="max-w-2xl border-t border-line pt-6 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0">
                <p class="text-ink-soft leading-relaxed">{sec.intro}</p>
                {"body" in sec && sec.body ? <p class="mt-3 text-ink-soft leading-relaxed">{sec.body}</p> : null}
                <ul class="mt-5 space-y-2.5">
                  {sec.points.map((p) => (
                    <li class="flex gap-3 text-sm text-ink-soft">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="mt-0.5 shrink-0 text-brand" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
                {sec.id === "global-focus" && (
                  <div class="mt-6">
                    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-faint">Popular destination guides</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {popularDestinationSlugs.map((slug) => {
                        const dest = getDestination(slug);
                        if (!dest) return null;
                        return <a href={`/${slug}`} class="rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:border-brand hover:text-brand">{dest.short}</a>;
                      })}
                    </div>
                  </div>
                )}
                {sec.id === "why" && (
                  <p class="mt-5 text-sm text-ink-soft">
                    Helpline: <a href={contact.phoneHref} data-track="phone_click" class="font-semibold text-brand-text hover:underline">{contact.phoneDisplay}</a>
                  </p>
                )}
              </div>
            </div>
          </Reveal>
        );
      })}

      <Reveal>
        <div id="offices" class="grid grid-cols-1 gap-8 lg:grid-cols-[220px_1fr]">
          <h2 class="text-2xl font-semibold text-ink">Our Offices</h2>
          <div class="max-w-2xl border-t border-line pt-6 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0">
            <ul class="space-y-4">
              {offices.map((o) => (
                <li class="text-sm text-ink-soft">
                  <strong class="block text-ink">{o.name}</strong>
                  {o.address}
                </li>
              ))}
              <li class="text-sm text-ink-soft">
                <strong class="block text-ink">Email</strong>
                <a href={`mailto:${contact.email}`} class="hover:text-brand">{contact.email}</a>
              </li>
              <li class="text-sm text-ink-soft">
                <strong class="block text-ink">Hours</strong>
                {contact.hours}
              </li>
            </ul>
            <a href="/contact-us" class="mt-6 inline-flex rounded-full bg-gradient-to-b from-brand to-brand-deep px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-brand/20 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand/30">Get in touch</a>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <section class="border-y border-line bg-surface-2/60 py-16">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <Reveal><SectionHeading eyebrow="Who we work with" title="Every background, one goal" lead="Students from different cities, fields, and starting points, all working toward the same next chapter." /></Reveal>
      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <Reveal delay={80}>
          <TiltCard class="overflow-hidden rounded-3xl border border-line shadow-lg shadow-ink/10" max={4}>
            <Image src={img("/images/stock/south-asian-students.webp")} alt="Two students reviewing coursework together before their applications" width={1000} height={667} loading="lazy" class="h-64 w-full object-cover" />
          </TiltCard>
        </Reveal>
        <Reveal delay={140}>
          <TiltCard class="overflow-hidden rounded-3xl border border-line shadow-lg shadow-ink/10" max={4}>
            <Image src={img("/images/stock/community-hands.webp")} alt="A diverse group of people joining hands, representing the community of students Apex supports" width={1000} height={667} loading="lazy" class="h-64 w-full object-cover" />
          </TiltCard>
        </Reveal>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-4 lg:px-8">
    <Reveal class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">The moment it's for</p>
        <p class="mt-3 text-xl font-semibold leading-snug text-ink sm:text-2xl">Every application, every document, every visa form leads here.</p>
        <p class="mt-4 text-ink-soft leading-relaxed">We stay focused on the outcome from day one: a student who made it, on their own merit, with a team that never lost sight of why the paperwork mattered.</p>
      </div>
      <TiltCard class="order-1 overflow-hidden rounded-3xl border border-line shadow-lg shadow-ink/10 lg:order-2" max={4}>
        <Image src={img("/images/stock/graduation.webp")} alt="Graduates celebrating at a graduation ceremony" width={1000} height={667} loading="lazy" class="h-64 w-full object-cover sm:h-80" />
      </TiltCard>
    </Reveal>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <Reveal>
      <div class="relative overflow-hidden rounded-3xl border border-line bg-gradient-to-br from-surface-2 to-surface px-8 py-14 sm:px-14">
        <div class="pointer-events-none absolute -left-10 -top-10 h-56 w-56 rounded-full bg-[radial-gradient(circle,rgba(21,128,61,0.16),transparent_70%)] blur-2xl"></div>
        <div class="relative grid grid-cols-1 items-center gap-10 lg:grid-cols-[0.9fr_1.1fr]">
          <div class="order-2 flex justify-center lg:order-1">
            <LuggageIllustration class="h-48 w-48 animate-float sm:h-56 sm:w-56" />
          </div>
          <div class="order-1 text-center lg:order-2 lg:text-left">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">Ready when you are</p>
            <h2 class="mt-2 text-3xl font-semibold text-ink sm:text-4xl">Pack Your Ambition</h2>
            <p class="mx-auto mt-4 max-w-lg text-ink-soft leading-relaxed lg:mx-0">
              Everything else, the paperwork, the planning, the visa filing, is what we're here for.
              Bring the ambition. We'll help you carry it the rest of the way.
            </p>
            <a href="/contact-us" class="mt-7 inline-flex rounded-full bg-gradient-to-b from-brand to-brand-deep px-6 py-3 text-sm font-semibold text-white shadow-md shadow-brand/20 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand/30">Book free consultation</a>
          </div>
        </div>
      </div>
    </Reveal>
  </section>

  <section class="border-y border-line bg-brand-deep py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <Reveal><SectionHeading tone="white" align="center" eyebrow="Since 2009" title="Our journey" /></Reveal>
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {journey.map((j, i) => (
          <Reveal delay={i * 90}>
            <div class="rounded-2xl border border-white/15 bg-white/5 p-6">
              <p class="font-display text-2xl font-semibold text-white">{j.year}</p>
              <p class="mt-2 text-sm leading-relaxed text-white/90">{j.text}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <Reveal><StatStrip /></Reveal>
    <p class="mt-6 text-sm text-ink-faint">
      Follow us on <a href={socials.facebook} target="_blank" rel="noopener noreferrer" class="text-brand-text underline underline-offset-2 hover:decoration-2">Facebook</a> and
      <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" class="text-brand-text underline underline-offset-2 hover:decoration-2">LinkedIn</a> for updates, events, and student success stories.
    </p>
  </section>
</BaseLayout>
