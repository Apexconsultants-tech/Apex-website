---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StickyContactBar from "@/components/StickyContactBar.astro";
import FloatingLuggageTag from "@/components/FloatingLuggageTag.astro";
import GoogleAnalytics from "@/components/GoogleAnalytics.astro";
import JsonLd from "@/components/JsonLd.astro";
import { localBusinessJsonLd, organizationJsonLd, websiteJsonLd } from "@/lib/structured-data";
import type { HeroPreload } from "@/lib/images";
import "@/styles/globals.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  noindex?: boolean;
  type?: "website" | "article";
  heroPreload?: HeroPreload;
}
const { title, description, canonical, ogImage, noindex, type, heroPreload } = Astro.props;
---
<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <BaseHead title={title} description={description} canonical={canonical} ogImage={ogImage} noindex={noindex} type={type} heroPreload={heroPreload} />
  </head>
  <body class="min-h-full flex flex-col font-sans text-ink bg-paper">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white">
      Skip to main content
    </a>
    <JsonLd data={[organizationJsonLd(), localBusinessJsonLd(), websiteJsonLd()]} />
    <Header />
    <main id="main-content" class="flex-1 pb-14 lg:pb-0">
      <slot />
    </main>
    <Footer />
    <StickyContactBar />
    <FloatingLuggageTag />
    <GoogleAnalytics />

    <script>
      import "@/scripts/reveal";
      import "@/scripts/tilt-card";
    </script>
  </body>
</html>
