---
import { Picture } from "astro:assets";
import { img } from "@/lib/images";
import Breadcrumb from "@/components/Breadcrumb.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import Reveal from "@/components/Reveal.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import TiltCard from "@/components/TiltCard.astro";
import type { ServiceData } from "@/lib/services-data";
import { services } from "@/lib/services-data";
import { serviceImage } from "@/lib/service-photos.server";
import { contact } from "@/lib/site-config";

interface Props { s: ServiceData }
const { s } = Astro.props;
const otherServices = services.filter((o) => o.slug !== s.slug);
const imagePath = serviceImage(s.slug);
---
<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,var(--color-brand-tint),transparent_55%)]"></div>
  <div class="mx-auto max-w-7xl px-5 pb-16 pt-10 lg:px-8 lg:pt-14">
    <Breadcrumb current={s.name} />
    <div class={`mt-6 grid grid-cols-1 items-center gap-10 ${imagePath ? "lg:grid-cols-[1.05fr_0.95fr]" : ""}`}>
      <div class={`animate-hero-in ${imagePath ? "" : "max-w-3xl"}`}>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">What We Do</p>
        <h1 class="mt-3 text-4xl font-semibold leading-[1.08] text-ink sm:text-5xl">{s.headline}</h1>
        <p class="mt-6 text-base leading-relaxed text-ink-soft sm:text-lg">{s.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact-us" class="rounded-full bg-gradient-to-b from-brand to-brand-deep px-6 py-3 text-sm font-semibold text-white shadow-md shadow-brand/20 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand/30">Book free consultation</a>
          <a href={contact.whatsappHref} data-track="whatsapp_click" target="_blank" rel="noopener noreferrer" class="rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink transition-all hover:-translate-y-0.5 hover:border-brand hover:text-brand">Chat on WhatsApp</a>
        </div>
      </div>
      {imagePath && (
        <TiltCard class="relative aspect-[4/3] overflow-hidden rounded-3xl border border-line shadow-lg shadow-ink/10" max={4}>
          <Picture src={img(imagePath)} formats={["avif", "webp"]} fallbackFormat="webp" alt={s.name} loading="eager" fetchpriority="high" decoding="async" widths={[480, 768, 1024]} sizes="(min-width: 1024px) 45vw, 90vw" quality={42} class="h-full w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>
        </TiltCard>
      )}
    </div>
  </div>
</section>

<section class="mx-auto max-w-3xl px-5 py-20 lg:px-8">
  <Reveal><h2 class="text-2xl font-semibold text-ink">How we support you</h2></Reveal>
  <div class="mt-5 space-y-4">
    {s.body.map((p, i) => <Reveal delay={i * 60}><p class="text-ink-soft leading-relaxed">{p}</p></Reveal>)}
  </div>
</section>

<section class="border-y border-line bg-surface-2/60 py-20">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <Reveal><SectionHeading eyebrow="What's included" title="How we support you" /></Reveal>
    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {s.includes.map((inc, i) => (
        <Reveal delay={i * 70}>
          <TiltCard class="h-full rounded-2xl border border-line bg-surface p-6" max={4}>
            <h3 class="text-base font-semibold text-ink">{inc.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{inc.body}</p>
          </TiltCard>
        </Reveal>
      ))}
    </div>
  </div>
</section>

<section class="mx-auto max-w-3xl px-5 py-20 lg:px-8">
  <Reveal><SectionHeading align="center" eyebrow="Common questions" title="FAQs" /></Reveal>
  <Reveal delay={100} class="mt-10"><FaqAccordion items={s.faqs} /></Reveal>
</section>

<section class="border-t border-line bg-surface-2/60 py-16">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.1em] text-ink-faint">Explore more</p>
    <h2 class="mt-1 text-xl font-semibold text-ink">Other services</h2>
    <div class="mt-5 flex flex-wrap gap-2">
      <a href="/#partner-logos" class="rounded-full border border-line bg-surface px-4 py-2 text-xs font-medium text-ink-soft transition-colors hover:border-brand hover:text-brand">Partner Universities</a>
      {otherServices.map((o) => (
        <a href={`/${o.slug}`} class="rounded-full border border-line bg-surface px-4 py-2 text-xs font-medium text-ink-soft transition-colors hover:border-brand hover:text-brand">{o.name}</a>
      ))}
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
  <Reveal>
    <div class="flex flex-col items-start justify-between gap-8 rounded-3xl bg-brand px-8 py-12 sm:px-12 lg:flex-row lg:items-center">
      <div>
        <h2 class="text-3xl font-semibold text-white sm:text-4xl">Ready to get started with {s.name}?</h2>
        <p class="mt-3 max-w-lg text-white">Book your free consultation today.</p>
      </div>
      <a href="/contact-us" class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-deep transition-all hover:-translate-y-0.5 hover:bg-white/90">Book free consultation</a>
    </div>
  </Reveal>
</section>
