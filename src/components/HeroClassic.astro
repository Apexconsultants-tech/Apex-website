---
import { Image } from "astro:assets";
import { img } from "@/lib/images";
import Globe from "@/components/Globe.astro";
import CourseFinder from "@/components/CourseFinder.astro";
import StatStrip from "@/components/StatStrip.astro";
import { contact } from "@/lib/site-config";
---
<section class="relative overflow-hidden">
  <div class="absolute inset-0">
    {/* WebP only, not AVIF, and capped at 1024w: this is the page's true
        LCP element (full-bleed background), and a large AVIF frame here
        measurably cost multiple seconds of decode time under throttled
        mobile CPU — the gradient/dark overlay on top of this image means
        the extra fine detail AVIF or a >1024px source would preserve is
        invisible anyway. */}
    <Image
      src={img("/images/stock/hero-cinematic-bg.webp")}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
      widths={[480, 768, 1024]}
      sizes="100vw"
      quality={60}
      class="h-full w-full object-cover object-center"
    />
  </div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/20"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-black/10"></div>
  <div class="pointer-events-none absolute inset-0 bg-brand-deep/10"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-[var(--color-paper)]"></div>

  <div class="relative mx-auto max-w-7xl px-5 pb-10 pt-14 lg:px-8 lg:pb-16 lg:pt-20">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
      <div class="animate-hero-in">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-white/90">Overseas education consultants since 2009</p>
        <h1 class="mt-3 text-4xl font-semibold leading-[1.06] text-white sm:text-5xl lg:text-6xl">
          Where Futures <span class="text-brand-tint">Cross Continents</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-white/90 sm:text-lg">
          Dreaming of a degree abroad but not sure where to even start? You're not alone, and
          you don't have to figure it out by yourself. Since 2009, we've walked students
          from Karachi, Hyderabad, and beyond through every step, picking the right course,
          acing the visa interview, and settling into life on a new campus, as ICEF-certified
          consultants who stay with you from your first conversation to the day you land.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact-us" class="rounded-full bg-gradient-to-b from-brand to-brand-deep px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand/20 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand/35">
            Book free consultation
          </a>
          <a href={contact.whatsappHref} data-track="whatsapp_click" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/40 px-6 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:border-white hover:bg-white/10">
            Chat on WhatsApp
          </a>
        </div>
      </div>

      <div class="flex items-center justify-center animate-hero-in" style="animation-delay: 120ms">
        <div class="relative mx-auto aspect-square w-full max-w-xs sm:max-w-sm lg:max-w-md">
          <div class="animate-float">
            <Globe />
          </div>
        </div>
      </div>
    </div>

    <div class="relative z-10 mt-20 animate-hero-in lg:mt-24" style="animation-delay: 200ms">
      <div class="mb-6 flex flex-col items-center rounded-3xl bg-black/35 px-6 py-6 text-center shadow-lg shadow-black/20 backdrop-blur-sm sm:px-10 sm:py-7">
        <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.1em] text-brand-deep shadow-lg shadow-black/10">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2" /><path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
          Course Finder
        </span>
        <h2 class="mt-4 max-w-xl text-2xl font-semibold leading-tight text-white sm:text-3xl">
          Not sure where to start? <span class="text-brand-tint">Find your perfect course</span> in seconds
        </h2>
      </div>
      <CourseFinder />
    </div>

    <div class="mt-14 animate-hero-in" style="animation-delay: 260ms">
      <StatStrip />
    </div>
  </div>
</section>
