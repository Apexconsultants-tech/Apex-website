---
import { contact, offices } from "@/lib/site-config";
const active = offices[0];
const mapSrc = `https://maps.google.com/maps?q=${active.mapQuery}&hl=en&z=${active.mapZoom}&output=embed`;
---
<div data-office-locations class="grid grid-cols-1 gap-8 lg:grid-cols-[380px_1fr]">
  <div class="flex flex-col gap-3">
    {offices.map((o, i) => (
      <div
        data-office-card
        data-map-query={o.mapQuery}
        data-map-zoom={o.mapZoom}
        data-office-name={o.name}
        class={`rounded-2xl border px-5 py-4 transition-colors ${i === 0 ? "border-brand bg-brand-tint" : "border-line bg-surface hover:border-brand/50"}`}
      >
        <button type="button" data-office-button aria-pressed={i === 0 ? "true" : "false"} class="w-full text-left">
          <span class="text-xs font-semibold text-ink-faint">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="mt-1 text-base font-semibold text-ink">{o.name}</h3>
          <p class="mt-1 text-sm text-ink-soft">{o.address}</p>
        </button>
        <a href={contact.phoneHref} data-track="phone_click" class="mt-2 inline-block text-sm font-semibold text-brand-text underline underline-offset-2 hover:decoration-2">
          {contact.phoneDisplay}
        </a>
      </div>
    ))}
  </div>
  <div class="overflow-hidden rounded-2xl border border-line">
    <iframe data-office-map src={mapSrc} width="100%" height="360" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Map: ${active.name}`} class="h-full min-h-[360px] w-full"></iframe>
  </div>
</div>

<script>
  import "@/scripts/office-locations";
</script>
