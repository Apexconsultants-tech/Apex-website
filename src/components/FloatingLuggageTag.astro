---
const W = 288;
const H = 104;
const R = 14;
const NOTCH_X = 76;
const NOTCH_R = 7;
const CARD_PATH = `
  M ${R},0
  L ${NOTCH_X - NOTCH_R},0
  A ${NOTCH_R},${NOTCH_R} 0 0 0 ${NOTCH_X + NOTCH_R},0
  L ${W - R},0
  A ${R},${R} 0 0 1 ${W},${R}
  L ${W},${H - R}
  A ${R},${R} 0 0 1 ${W - R},${H}
  L ${NOTCH_X + NOTCH_R},${H}
  A ${NOTCH_R},${NOTCH_R} 0 0 0 ${NOTCH_X - NOTCH_R},${H}
  L ${R},${H}
  A ${R},${R} 0 0 1 0,${H - R}
  L 0,${R}
  A ${R},${R} 0 0 1 ${R},0
  Z
`.trim();
const barcodeX = [8, 13, 16, 22, 27, 32, 38, 41, 47, 52, 58, 63];
---
<div data-luggage-tag class="pointer-events-none fixed bottom-6 right-6 z-40 hidden lg:block">
  <div class="animate-slide-in-right pointer-events-auto relative" style={`width: ${W}px; filter: drop-shadow(0 10px 28px rgba(21,128,61,0.35))`}>
    <button type="button" data-luggage-tag-close aria-label="Dismiss" class="absolute -right-2 -top-2 z-10 flex h-6 w-6 items-center justify-center rounded-full border border-line bg-surface text-ink-faint shadow-sm transition-colors hover:text-ink">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      </svg>
    </button>

    <a href="/contact-us" class="group relative block" style={`width: ${W}px; height: ${H}px`}>
      <svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} class="absolute inset-0 drop-shadow-xl transition-transform group-hover:-translate-y-0.5">
        <path d={CARD_PATH} class="fill-surface stroke-line" stroke-width="1" />
        <line x1={NOTCH_X} y1={NOTCH_R + 4} x2={NOTCH_X} y2={H - NOTCH_R - 4} stroke="var(--color-line)" stroke-width="1.5" stroke-dasharray="3 4" />
        <g class="fill-ink-faint" opacity="0.4">
          {barcodeX.map((x, i) => <rect x={x} y={H - 14} width={i % 3 === 0 ? 2 : 1} height="8" />)}
        </g>
      </svg>

      <div class="absolute inset-y-0 left-0 flex flex-col items-center justify-center gap-1.5" style={`width: ${NOTCH_X}px`}>
        <span class="flex h-8 w-8 items-center justify-center rounded-full text-white shadow-sm" style="background: linear-gradient(160deg, #0ea5e9, #2563eb)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M21 15v-2l-8-5V4.5a1.5 1.5 0 0 0-3 0V8l-8 5v2l8-2.5V17l-2.5 1.5V20l4-1 4 1v-1.5L13 17v-4.5l8 2.5Z" />
          </svg>
        </span>
        <span class="text-[8px] font-bold uppercase tracking-[0.14em] text-ink-faint">Apex</span>
      </div>

      <div class="absolute inset-y-0 flex flex-col justify-center gap-1 py-3 pr-5" style={`left: ${NOTCH_X + 14}px; right: 0`}>
        <div class="flex items-center justify-between">
          <span class="text-[9px] font-bold uppercase tracking-[0.16em] text-ink-faint">Boarding Pass</span>
          <span class="text-[9px] font-bold uppercase tracking-[0.1em] text-brand-text">Open</span>
        </div>
        <div class="mt-1 flex items-baseline gap-1.5">
          <span class="font-display text-sm font-bold text-ink">HOME</span>
          <span class="text-ink-faint">✈</span>
          <span class="font-display text-sm font-bold text-ink">ABROAD</span>
        </div>
        <p class="text-[11px] leading-snug text-ink-soft">Book a free consultation</p>
        <span class="mt-0.5 inline-flex items-center gap-1 text-[11px] font-semibold text-brand-text">
          Explore countries
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </span>
      </div>
    </a>
  </div>
</div>

<script>
  import "@/scripts/floating-luggage-tag";
</script>
