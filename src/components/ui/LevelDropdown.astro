---
const LEVEL_GROUPS = [
  {
    group: "Undergraduate",
    options: ["Post-Secondary Certificate", "Undergraduate Diploma", "3-Year Bachelor's Degree", "Top-up Degree", "4-Year Bachelor's Degree", "Integrated Master's"],
  },
  {
    group: "Postgraduate",
    options: ["Postgraduate Certificate", "Postgraduate Diploma", "Doctoral / PhD", "Non-Credential", "Master's Degree"],
  },
  {
    group: "Elementary & High School",
    options: Array.from({ length: 12 }, (_, i) => `Grade ${i + 1}`),
  },
];
---
<div data-dropdown class="relative mt-1">
  <input type="hidden" name="level" value="" />
  <button type="button" data-dropdown-trigger aria-haspopup="listbox" aria-expanded="false" aria-label="Class" class="flex w-full items-center justify-between gap-2 bg-transparent py-1 text-left text-sm font-medium text-ink focus:outline-none">
    <span data-dropdown-label class="text-ink-faint">Any level</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <div data-dropdown-panel role="listbox" class="hidden absolute left-0 top-full z-20 mt-2 max-h-80 w-72 overflow-y-auto rounded-xl border border-line bg-surface p-2 shadow-xl shadow-ink/10">
    {LEVEL_GROUPS.map((g, gi) => (
      <div class={gi > 0 ? "mt-4" : ""}>
        <div class="rounded-md bg-brand-tint px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-brand-text">{g.group}</div>
        <div class="mt-1">
          {g.options.map((o) => (
            <button type="button" data-dropdown-option data-value={o} role="option" aria-selected="false" class="block w-full rounded-md px-2 py-1.5 text-left text-sm text-ink transition-colors hover:bg-surface-2">
              {o}
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
