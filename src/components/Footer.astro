---
import { contact, destinations, icef, offices, site, socials } from "@/lib/site-config";
import { flagSize } from "@/lib/flags";

const year = new Date().getFullYear();
---
<footer class="border-t border-line bg-surface">
  <div class="mx-auto max-w-7xl px-5 py-14 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <a href="/" aria-label="Apex Consulting Services home">
          <img src="/images/brand/apex-logo.webp" alt="Apex Consulting Services" width="1520" height="283" class="h-8 w-auto" />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-soft">
          Trusted overseas education consultancy since {site.foundedYear}. Admissions, visas, and
          student support from Pakistan to the world.
        </p>
        <div class="mt-5 flex items-center gap-3">
          <a href={socials.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:border-brand hover:text-brand">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5H16l.5-3H13.5V8.5c0-.87.24-1.46 1.5-1.46H16.5V4.36C16.22 4.32 15.26 4.24 14.14 4.24c-2.34 0-3.94 1.43-3.94 4.05V10.5H7.5v3H10.2V21h3.3Z" /></svg>
          </a>
          <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:border-brand hover:text-brand">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.4 8.75h3.48V21H3.4V8.75Zm6.2 0h3.34v1.68h.05c.47-.88 1.6-1.8 3.3-1.8 3.52 0 4.17 2.32 4.17 5.33V21h-3.48v-5.34c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.81V21H9.6V8.75Z" /></svg>
          </a>
        </div>
        <a href={icef.certificateUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink-soft transition-colors hover:border-brand hover:text-brand" title="Verify ICEF Agency Status (IAS) certification">
          <img src="/images/brand/icef-ias-badge.svg" alt="" width="20" height="20" class="h-5 w-5" />
          ICEF Agency Status, IAS #{icef.iasId}
        </a>
      </div>

      <div class="lg:col-span-2">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-faint">Important Links</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-ink-soft">
          <li><a href="/about-us" class="hover:text-brand">About Us</a></li>
          <li><a href="/#services" class="hover:text-brand">Our Services</a></li>
          <li><a href="/destinations" class="hover:text-brand">Study Destinations</a></li>
          <li><a href="/#partner-logos" class="hover:text-brand">Partner Universities</a></li>
          <li><a href="/success-stories" class="hover:text-brand">Success Stories</a></li>
          <li><a href="/faqs" class="hover:text-brand">FAQs</a></li>
          <li><a href="/contact-us" class="hover:text-brand">Contact Us</a></li>
        </ul>
      </div>

      <div class="lg:col-span-4">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-faint">Study Destinations</h3>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm text-ink-soft sm:grid-cols-3">
          {destinations.map((d) => {
            const fs = flagSize(d.flag, 10);
            return (
              <li>
                <a href={`/${d.slug}`} class="flex items-center gap-1.5 hover:text-brand">
                  <img src={`/images/flags/${d.flag}.svg`} alt="" width={fs.width} height={fs.height} class="shrink-0 rounded-[1px]" />
                  <span class="truncate">{d.short}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-faint">Contact Us</h3>
        <ul class="mt-4 space-y-3 text-sm text-ink-soft">
          {offices.slice(0, 3).map((o) => (
            <li>
              <strong class="block text-ink">{o.name}</strong>
              <span>{o.address}</span>
            </li>
          ))}
          <li>
            <strong class="block text-ink">Helpline</strong>
            <a href={contact.phoneHref} data-track="phone_click" class="hover:text-brand">{contact.phoneDisplay}</a>
          </li>
          <li>
            <strong class="block text-ink">Email</strong>
            <a href={`mailto:${contact.email}`} class="hover:text-brand">{contact.email}</a>
          </li>
          <li>
            <strong class="block text-ink">Hours</strong>
            <span>{contact.hours}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-line pt-6 text-xs text-ink-faint sm:flex-row sm:items-center">
      <p>Copyright © {site.foundedYear}–{year}. {site.name}</p>
      <div class="flex gap-5">
        <a href="/privacy-policy" class="hover:text-brand">Privacy Policy</a>
        <a href="/terms" class="hover:text-brand">Terms of Service</a>
        <a href="/student-guidance-ethics-complaints" class="hover:text-brand">Student Guidance & Complaints</a>
        <a href="/contact-us" class="hover:text-brand">Contact Us</a>
      </div>
    </div>
  </div>
</footer>
