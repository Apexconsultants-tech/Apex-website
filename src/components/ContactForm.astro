---
import { contactFormDestinations } from "@/lib/site-config";
---
<form data-contact-form class="space-y-5" novalidate>
  <input type="text" name="company" tabindex="-1" autocomplete="off" class="absolute left-[-9999px] h-0 w-0 opacity-0" aria-hidden="true" />

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div>
      <label for="first_name" class="mb-1.5 block text-sm font-medium text-ink">First Name <span class="text-amber">*</span></label>
      <input id="first_name" name="first_name" type="text" required maxlength="100" placeholder="Your first name" class="w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/40" />
      <p data-error-for="firstName" class="mt-1.5 hidden text-xs text-amber" role="alert"></p>
    </div>

    <div>
      <label for="last_name" class="mb-1.5 block text-sm font-medium text-ink">Last Name <span class="text-amber">*</span></label>
      <input id="last_name" name="last_name" type="text" required maxlength="100" placeholder="Your last name" class="w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/40" />
      <p data-error-for="lastName" class="mt-1.5 hidden text-xs text-amber" role="alert"></p>
    </div>

    <div>
      <label for="email" class="mb-1.5 block text-sm font-medium text-ink">Email ID <span class="text-amber">*</span></label>
      <input id="email" name="email" type="email" required maxlength="255" placeholder="you@email.com" class="w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/40" />
      <p data-error-for="email" class="mt-1.5 hidden text-xs text-amber" role="alert"></p>
    </div>

    <div>
      <label for="mobile" class="mb-1.5 block text-sm font-medium text-ink">Mobile Number <span class="text-amber">*</span></label>
      <input id="mobile" name="mobile" type="tel" required maxlength="15" placeholder="+92 300 0000000" class="w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/40" />
      <p data-error-for="mobile" class="mt-1.5 hidden text-xs text-amber" role="alert"></p>
    </div>

    <div class="sm:col-span-2">
      <label for="destination" class="mb-1.5 block text-sm font-medium text-ink">Preferred study destination <span class="text-amber">*</span></label>
      <select id="destination" name="destination" required class="w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-ink focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/40">
        <option value="" selected disabled>Select destination</option>
        {contactFormDestinations.map((d) => <option value={d}>{d}</option>)}
      </select>
      <p data-error-for="destination" class="mt-1.5 hidden text-xs text-amber" role="alert"></p>
    </div>

    <div class="sm:col-span-2">
      <label for="message" class="mb-1.5 block text-sm font-medium text-ink">How can we help you? <span class="text-amber">*</span></label>
      <textarea id="message" name="message" required rows="5" maxlength="2000" placeholder="Tell us about your study plans, preferred intake, or any questions..." class="w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/40"></textarea>
      <p data-error-for="message" class="mt-1.5 hidden text-xs text-amber" role="alert"></p>
    </div>
  </div>

  <label class="flex items-start gap-3 text-sm text-ink-soft">
    <input type="checkbox" name="consent" value="1" required checked class="mt-0.5 h-4 w-4 rounded border-line text-brand focus:ring-brand" />
    <span>
      I consent to receiving calls, WhatsApp, and email from Apex to assist with this enquiry, per the
      <a href="/privacy-policy" class="font-semibold text-brand-text underline underline-offset-2 hover:decoration-2">Privacy Policy</a>.
    </span>
  </label>

  <button type="submit" class="w-full rounded-full bg-gradient-to-b from-brand to-brand-deep px-6 py-3 text-sm font-semibold text-white shadow-md shadow-brand/20 transition-all hover:shadow-xl hover:shadow-brand/30 disabled:cursor-not-allowed disabled:opacity-60 disabled:shadow-none sm:w-auto">
    Submit Enquiry
  </button>

  <div role="status" aria-live="polite">
    <p data-form-status class="hidden"></p>
  </div>
</form>

<script>
  import "@/scripts/contact-form";
</script>
